NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgresql://antojit:antojit@127.0.0.1:5432/antojit_os
BOOTSTRAP_TOKEN=replace-this-before-using-a-real-network
SESSION_PEPPER=replace-this-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
SEED_ADMIN_PIN=1234
SEED_WAITER_PIN=2345
SEED_CASHIER_PIN=3456
VITE_REMOTE_MODE=false
VITE_API_URL=/api
VITE_APP_MODE=pos
PRINT_AGENT_MODE=simulator
PRINT_AGENT_API_URL=http://127.0.0.1:3000/api
PRINT_AGENT_CODE=PRINT-01
PRINT_AGENT_NAME=Agente de impresión principal
PRINT_AGENT_CENTERS=KITCHEN,BAR
PRINT_AGENT_REGISTERS=MAIN
PRINT_AGENT_OUTPUT_DIR=var/print-simulator

# Bixolon SRP-F310: rollo de 80 mm, 42 columnas con fuente A, español CP858.
PRINTER_COLUMNS=42
PRINTER_ENCODING=cp858
PRINTER_CODE_PAGE=19
PRINTER_TIMEOUT_MS=10000
# Red: PRINT_AGENT_MODE=tcp, PRINTER_HOST=IP_DE_LA_IMPRESORA, PRINTER_PORT=9100.
# USB con agente en la PC: PRINT_AGENT_MODE=system, PRINTER_QUEUE="BIXOLON SRP-F310".
