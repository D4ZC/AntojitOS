{
  "name": "antojit-os",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --filter @antojit-os/domain build && pnpm --filter @antojit-os/pos build",
    "check": "pnpm --filter @antojit-os/domain check && pnpm --filter @antojit-os/pos check",
    "dev": "pnpm --filter @antojit-os/pos dev",
    "test": "pnpm --filter @antojit-os/domain test && pnpm --filter @antojit-os/pos test",
    "test:offline": "node --test packages/domain/tests/order.node.test.mjs"
  }
}
