NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=antojit_os
POSTGRES_USER=antojit
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

BOOTSTRAP_TOKEN=__BOOTSTRAP_TOKEN__
SESSION_PEPPER=__SESSION_PEPPER__
SESSION_TTL_HOURS=12
SEED_ADMIN_PIN=__ADMIN_PIN__
SEED_WAITER_PIN=__WAITER_PIN__

PILOT_HTTP_PORT=8080
# Windows usa 127.0.0.1 y publica el acceso LAN mediante su proxy TCP.
PILOT_BIND_ADDRESS=0.0.0.0

PRINT_AGENT_MODE=simulator
PRINT_AGENT_API_URL=http://api:3000/api
PRINT_AGENT_SITE_CODE=PILOT
PRINT_AGENT_CODE=PRINT-01
PRINT_AGENT_NAME=Agente de impresión principal
PRINT_AGENT_CENTERS=KITCHEN,BAR
PRINT_AGENT_REGISTERS=MAIN
PRINT_AGENT_CREDENTIALS_PATH=/data/credentials.json
PRINT_AGENT_OUTPUT_DIR=/data/simulator
PRINT_AGENT_POLL_MS=1000

# Bixolon SRP-F310, papel de 80 mm; consultar docs/phase-3/BIXOLON_SRP_F310.md.
PRINTER_COLUMNS=42
PRINTER_ENCODING=cp858
PRINTER_CODE_PAGE=19
PRINTER_TIMEOUT_MS=10000

# Para una impresora de red, cambiar PRINT_AGENT_MODE=tcp y configurar:
# PRINTER_HOST=192.168.1.50
# PRINTER_PORT=9100
